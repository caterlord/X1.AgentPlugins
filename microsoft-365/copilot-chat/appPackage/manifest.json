{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.26/MicrosoftTeams.schema.json",
  "manifestVersion": "1.26",
  "version": "1.0.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "X1",
    "websiteUrl": "https://posx1.ai/",
    "privacyUrl": "https://posx1.ai/privacy/",
    "termsOfUseUrl": "https://posx1.ai/terms/"
  },
  "name": {
    "short": "X1 HQ Pilot",
    "full": "X1 HQ Reporting Pilot"
  },
  "description": {
    "short": "Read authorized X1 HQ sales summaries in Microsoft 365 Copilot Chat.",
    "full": "Resolve your authorized X1 HQ workspace and retrieve sales totals and transaction counts for a selected brand or shop and date range. This pilot uses the X1 staging MCP gateway."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#1C3462",
  "validDomains": ["x1hq-mcp-staging.azurewebsites.net"],
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "x1HQReporting",
        "file": "declarativeAgent.json"
      }
    ]
  }
}
